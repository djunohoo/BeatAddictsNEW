SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Required for /pulse/chat to return real replies (see services/pulse.py).
# OpenAI-compatible chat completions endpoint (e.g. a local Ollama instance).
# ONSPACE_AI_API_KEY may be left blank if the endpoint needs no auth.
ONSPACE_AI_BASE_URL=
ONSPACE_AI_API_KEY=
ONSPACE_AI_MODEL=

# Optional
# Comma-separated list of allowed CORS origins, e.g. "https://beataddicts.app,http://localhost:5000".
# Defaults to "*" (any origin) if unset — fine for local/LAN dev, tighten before public deploy.
CORS_ALLOWED_ORIGINS=

# Daily per-user generation cap enforced server-side (requires Supabase configured above).
# Defaults to 20 if unset.
GENERATION_DAILY_LIMIT=
